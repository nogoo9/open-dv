{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendv.dev/schemas/v2/cli-spec.schema.json",
  "title": "Open-DV V2 Unified CLI Specification Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["cli_version", "root_command", "global_options", "subcommands"],
  "properties": {
    "$schema": { "type": "string" },
    "cli_version": { "type": "string", "pattern": "^2\\.\\d+\\.\\d+$" },
    "root_command": { "type": "string", "const": "opendv" },
    "global_options": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "flag", "type", "required", "help"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "flag": { "type": "string", "pattern": "^--[a-z0-9-]+$" },
          "short": { "type": ["string", "null"] },
          "type": { "type": "string" },
          "required": { "type": "boolean" },
          "default": {},
          "help": { "type": "string" }
        }
      }
    },
    "subcommands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "help", "options"],
        "properties": {
          "path": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "help": { "type": "string" },
          "http_method": { "type": ["string", "null"] },
          "http_route": { "type": ["string", "null"] },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "flag", "type", "required", "help"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "flag": { "type": "string", "pattern": "^--[a-z0-9-]+$" },
                "short": { "type": ["string", "null"] },
                "type": { "type": "string" },
                "required": { "type": "boolean" },
                "default": {},
                "choices": {
                  "type": ["array", "null"],
                  "items": { "type": "string" }
                },
                "help": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
