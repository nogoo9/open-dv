{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-dv.org/schemas/vault-observability-event.schema.json",
  "title": "VaultObservabilityEvent",
  "description": "Unified JSONL telemetry event emitted by open-dv agents (Vault First Mate, scout-source, scout-unstructured, ship-vault, axi-dv, and DeterministicCompiler) over state/vault-ledger.jsonl to drive the 12-View Explainability & Observability Workbench (WB-00 through WB-11).",
  "type": "object",
  "required": [
    "event_id",
    "run_id",
    "timestamp_utc",
    "stage_id",
    "workbench_view_id",
    "viz_id",
    "agent_persona",
    "status",
    "layer1_story_banner",
    "layer2_visual_payload"
  ],
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier for this telemetry event (UUIDv7 or deterministic trace ID)."
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "description": "Pipeline execution run identifier."
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "description": "Optional W3C Trace Context 32-hex trace identifier correlating multi-agent spans across a pipeline run."
    },
    "span_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "description": "Optional W3C Trace Context 16-hex span identifier for this specific agent task or gate evaluation."
    },
    "parent_span_id": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{16}$",
      "description": "Optional W3C Trace Context 16-hex parent span identifier."
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp when the event was emitted."
    },
    "stage_id": {
      "type": "string",
      "enum": [
        "STAGE_00_ORCHESTRATION",
        "STAGE_01_SCOUT_SOURCE",
        "STAGE_02_SCOUT_UNSTRUCTURED",
        "STAGE_03_SHIP_VAULT_PASS1",
        "STAGE_04_SHIP_VAULT_PASS2",
        "STAGE_05_AXI_DV_STATIC_GATES",
        "STAGE_06_AXI_DV_DYNAMIC_SANDBOX",
        "STAGE_07_DETERMINISTIC_COMPILER"
      ]
    },
    "phase_id": {
      "type": "string",
      "description": "Canonical 8-phase lifecycle identifier corresponding to stage_id.",
      "enum": [
        "P1_INGESTION",
        "P2_PROFILING",
        "P3_EXTRACTION",
        "P4_SYNTHESIS_PASS1",
        "P5_SYNTHESIS_PASS2",
        "P6_VERIFICATION",
        "P7_DYNAMIC_SANDBOX",
        "P8_OPERATIONS"
      ]
    },
    "step_id": {
      "type": "string",
      "description": "Optional step visualization identifier bound to the active pipeline phase.",
      "enum": [
        "VIZ-PIPE-00",
        "VIZ-STEP-01",
        "VIZ-STEP-02",
        "VIZ-STEP-03",
        "VIZ-STEP-04",
        "VIZ-STEP-05",
        "VIZ-STEP-06",
        "VIZ-STEP-07",
        "VIZ-STEP-08"
      ]
    },
    "gate_id": {
      "type": "string",
      "description": "Verification gate identifier (required when phase_id is P6_VERIFICATION; prohibited on non-P6 phases).",
      "enum": [
        "G1",
        "G2",
        "G3",
        "G4",
        "G5",
        "G6",
        "G_DYN",
        "G_AUD"
      ]
    },
    "rule_code": {
      "type": "string",
      "minLength": 1,
      "description": "Primary verification rule code evaluated during P6_VERIFICATION."
    },
    "contract_version": {
      "type": "string",
      "enum": ["5.0", "6.0"],
      "description": "Contract schema version governing the pipeline execution."
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Normalized confidence score in [0.0, 1.0] for discovery, resolution, or extraction events."
    },
    "workbench_view_id": {
      "type": "string",
      "enum": [
        "WB-00",
        "WB-01",
        "WB-02",
        "WB-03",
        "WB-04",
        "WB-05",
        "WB-06",
        "WB-07",
        "WB-08",
        "WB-09",
        "WB-10",
        "WB-11"
      ]
    },
    "viz_id": {
      "type": "string",
      "enum": [
        "VIZ-PIPE-00",
        "VIZ-STEP-01",
        "VIZ-STEP-02",
        "VIZ-STEP-03",
        "VIZ-STEP-04",
        "VIZ-STEP-05",
        "VIZ-STEP-06",
        "VIZ-STEP-07",
        "VIZ-STEP-08",
        "VIZ-GATE-01",
        "VIZ-GATE-02",
        "VIZ-GATE-03",
        "VIZ-GATE-04",
        "VIZ-GATE-05",
        "VIZ-GATE-06",
        "VIZ-GATE-07",
        "VIZ-GATE-08"
      ]
    },
    "agent_persona": {
      "type": "string",
      "enum": [
        "vault-first-mate",
        "scout-source",
        "scout-unstructured",
        "ship-vault",
        "axi-dv",
        "deterministic-compiler"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "AUTO-FIX",
        "AUTO_REPAIRED",
        "REJECT-WITH-TRACE",
        "ASK-USER"
      ]
    },
    "remediation": {
      "type": "object",
      "description": "Mandatory structured codemod payload when status is AUTO_REPAIRED.",
      "required": ["codemod_type", "target_entity", "patch_diff"],
      "additionalProperties": false,
      "properties": {
        "codemod_type": {"type": "string", "minLength": 1},
        "target_entity": {"type": "string", "minLength": 1},
        "patch_diff": {"type": "string", "minLength": 1},
        "action_description": {"type": "string"}
      }
    },
    "rule_ids_evaluated": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(DV-[A-Z]+-[0-9]{3}|ALG-A[0-9A-Za-z]+|INV-[0-9]{2}|KEY-[0-9]{2}|TMP-[0-9]{2}|EVO-[0-9]{2}|U[1-4]|AP-[0-9]{2})$"
      }
    },
    "context_refs": {
      "type": "object",
      "description": "Content-addressable SHA-256 artifact references under state/artifacts/<sha256>.",
      "additionalProperties": false,
      "properties": {
        "graph_a_sha256": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{64}$"
        },
        "graph_b_sha256": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{64}$"
        },
        "contract_yaml_pre_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9A-Fa-f]{64}$"
        },
        "contract_yaml_post_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9A-Fa-f]{64}$"
        },
        "canonical_ir_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9A-Fa-f]{64}$"
        },
        "compiled_sql_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9A-Fa-f]{64}$"
        },
        "toon_trace_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9A-Fa-f]{64}$"
        }
      }
    },
    "data_classification": {
      "type": "string",
      "description": "Highest sensitivity of any value in the event's Layer 1, Layer 2, or Layer 3 payload. CONFIDENTIAL, MNPI, and RESTRICTED_PII values are masked unless the viewer's RBAC role clears them.",
      "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "MNPI", "RESTRICTED_PII"]
    },
    "layer1_story_banner": {
      "type": "object",
      "required": ["headline", "business_impact", "verdict_pill"],
      "additionalProperties": false,
      "properties": {
        "headline": {"type": "string", "maxLength": 140},
        "business_impact": {"type": "string", "maxLength": 200},
        "verdict_pill": {
          "type": "string",
          "enum": ["PASS", "AUTO-FIX", "AUTO_REPAIRED", "REJECT-WITH-TRACE", "ASK-USER"]
        }
      }
    },
    "layer2_visual_payload": {
      "type": "object",
      "description": "Structured visual canvas payload using Semantic Hash Pills (`[HK: 5d15..0ae4 | GLOBAL:LP-101 CalPERS]`).",
      "required": ["semantic_hash_pills", "summary_metrics"],
      "additionalProperties": true,
      "properties": {
        "semantic_hash_pills": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["pill_label", "full_sha256_hex", "bkcc_prefix", "business_key", "entity_label"],
            "additionalProperties": false,
            "properties": {
              "pill_label": {"type": "string"},
              "full_sha256_hex": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
              "bkcc_prefix": {"type": "string"},
              "business_key": {"type": "string"},
              "entity_label": {"type": "string"}
            }
          }
        },
        "summary_metrics": {
          "type": "object",
          "additionalProperties": {
            "type": ["number", "string", "boolean"]
          }
        }
      }
    },
    "layer3_formal_proof": {
      "type": "object",
      "description": "On-demand formal proof drawer payload (collapsed by default in UI).",
      "additionalProperties": false,
      "properties": {
        "algorithm_ref": {"type": "string"},
        "formula_latex": {"type": "string"},
        "toon_diagnostic_payload": {"type": "string"},
        "contract_yaml_diff": {"type": "string"},
        "sqlglot_ast_summary": {"type": "string"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"phase_id": {"const": "P6_VERIFICATION"}},
        "required": ["phase_id"]
      },
      "then": {
        "required": ["gate_id", "rule_code"]
      }
    },
    {
      "if": {
        "properties": {"phase_id": {"not": {"const": "P6_VERIFICATION"}}},
        "required": ["phase_id"]
      },
      "then": {
        "not": {"required": ["gate_id"]}
      }
    },
    {
      "if": {
        "properties": {"phase_id": {"const": "P1_INGESTION"}},
        "required": ["phase_id", "step_id"]
      },
      "then": {
        "properties": {"step_id": {"enum": ["VIZ-PIPE-00", "VIZ-STEP-01"]}}
      }
    },
    {
      "if": {
        "properties": {"phase_id": {"const": "P2_PROFILING"}},
        "required": ["phase_id", "step_id"]
      },
      "then": {
        "properties": {"step_id": {"enum": ["VIZ-STEP-02", "VIZ-STEP-03"]}}
      }
    },
    {
      "if": {
        "properties": {"phase_id": {"const": "P3_EXTRACTION"}},
        "required": ["phase_id", "step_id"]
      },
      "then": {
        "properties": {"step_id": {"enum": ["VIZ-STEP-04"]}}
      }
    },
    {
      "if": {
        "properties": {"phase_id": {"const": "P4_SYNTHESIS_PASS1"}},
        "required": ["phase_id", "step_id"]
      },
      "then": {
        "properties": {"step_id": {"enum": ["VIZ-STEP-05"]}}
      }
    },
    {
      "if": {
        "properties": {"phase_id": {"const": "P5_SYNTHESIS_PASS2"}},
        "required": ["phase_id", "step_id"]
      },
      "then": {
        "properties": {"step_id": {"enum": ["VIZ-STEP-06"]}}
      }
    },
    {
      "if": {
        "properties": {"phase_id": {"const": "P8_OPERATIONS"}},
        "required": ["phase_id", "step_id"]
      },
      "then": {
        "properties": {"step_id": {"enum": ["VIZ-STEP-07", "VIZ-STEP-08"]}}
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "AUTO_REPAIRED"}},
        "required": ["status"]
      },
      "then": {
        "required": ["remediation"]
      }
    }
  ]
}
