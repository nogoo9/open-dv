{
	"name": "@opendv/web",
	"version": "2.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"codegen": "bun x openapi-typescript ../schemas/v2/openapi.json -o src/api/types.generated.ts",
		"build": "bun run src/build-static.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome check src tests e2e",
		"test": "bun test tests",
		"test:e2e": "bun x playwright test"
	},
	"dependencies": {
		"@xyflow/react": "^12.12.1",
		"elkjs": "^0.12.1",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"yaml": "^2.9.1",
		"zustand": "^5.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@playwright/test": "^1.65.1",
		"@types/bun": "^1.3.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"happy-dom": "^15.11.7 || ^21.0.4",
		"openapi-typescript": "^7.13.0",
		"typescript": "^5.8.0"
	}
}
