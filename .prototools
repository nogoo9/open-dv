# /.prototools
# Deterministic toolchain version pins managed by moonrepo proto (>=0.55.0).
# Run `proto install` or `moon setup` to provision all pinned runtimes.

moon = "2.3.0"
python = "3.12.13"
uv = "0.11.11"
bun = "1.3.13"

[settings]
auto-install = true
auto-clean = false
detect-strategy = "first-available"
