{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "paths": {
      "@opendv/protocol-ts": [
        "../../packages/opendv-protocol-ts/src/index.ts"
      ],
      "@opendv/protocol-ts/*": [
        "../../packages/opendv-protocol-ts/src/*"
      ]
    }
