{
	"name": "@opendv/website",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"dependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@playwright/test": "1.65.1",
		"@types/bun": "^1.3.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"typescript": "^5.8.0"
	},
	"scripts": {
		"build": "tsc --noEmit && bun run src/build.ts",
		"build:static": "bun run src/build.ts",
		"dev": "bun run src/preview.ts",
		"lint": "bun x biome check src",
		"preview": "bun run src/preview.ts",
		"test": "bun test",
		"test:e2e": "bun x playwright test",
		"typecheck": "tsc --noEmit"
	}
}
