# Open-DV Platform Runtime Environment Variables
OPENDV_CONFIG=opendv.config.yaml
OPENDV_WORKSPACE_ROOT=.

# Ontology Construction Studio Runtime & Governance Configuration
# Root directory for Ontology Studio Content-Addressable Storage (CAS) and sessions
# OPENDV_STUDIO_ROOT=.opendv/ontology_studio
# Execution security mode: local_standalone (loopback single-tenant) or remote_platform (multi-user RS256 JWT RBAC)
# OPENDV_SERVER_MODE=local_standalone
# Bearer authentication token for Ontology Studio API / opendv & opendvctl client requests
# OPENDV_TOKEN=
# OPENDV_STUDIO_TOKEN=
# Dedicated administrative secret key authorizing ONT-EVO-002 low-confidence Path A waivers
# OPENDV_WAIVER_KEY=
# OS path-separator-delimited (os.pathsep: ':' on Linux/macOS, ';' on Windows — never comma) allowlist of workspace directories permitted for Ontology Studio promotion
# OPENDV_WORKSPACE_ROOTS=.

# Optional Agent Harness Credentials (if running pipeline with live models)
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

