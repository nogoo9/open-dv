# Open-DV V2 Runtime & Agent Harness Environment Variables
# Core workspace paths & secret precedence
# OPENDV_HOME=.opendv
# OPENDV_SECRET_PRECEDENCE=store_first
# OPENDV_WORKSPACE_ROOTS=.

# Optional Server & CLI Transport Overrides
# OPENDV_API_URL=http://127.0.0.1:8420
# OPENDV_STATIC_DIR=
# OPENDV_BOUND_HOST=127.0.0.1
# OPENDV_ALLOW_REMOTE_UNAUTHENTICATED=0

# Isolated Step 4 MCP broker role tokens (auto-minted when running in-process)
# OPENDV_MCP_COORD_TOKEN=
# OPENDV_MCP_SCOUT_TOKEN=

# Optional Agent CLI Binary & Effort Overrides
# OPENDV_AGY_CLI_BIN=
# OPENDV_CLAUDE_CLI_BIN=
# OPENDV_CLAUDE_EFFORT=low

# Optional Model Overrides (Tier -> Provider override)
# OPENDV_AGY_HIGH_MODEL=
# OPENDV_AGY_FAST_MODEL=
# OPENDV_GEMINI_HIGH_MODEL=
# OPENDV_GEMINI_FAST_MODEL=
# OPENDV_CLAUDE_HIGH_MODEL=
# OPENDV_CLAUDE_FAST_MODEL=

# Optional Reference Pack & Baseline Digest Overrides
# OPENDV_FIBO_PACK_PATH=
# OPENDV_BASELINE_DIGESTS_PATH=
